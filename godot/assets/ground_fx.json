{
  // Ground FX tuning (particle prototype, 2026-09-14). Hot-editable: footstep and
  // landing dust magnitudes, the stride cadence, and the readability budget. Pairs
  // are [min, max] lerped by the normalized driver (impact energy for landings,
  // ground speed for footsteps). The budget caps clamp at load against hard code
  // ceilings (opacity 0.4, lifetime 0.8 s, 32/burst, 16 events/frame) — dust can
  // be tuned quieter, never past legibility.
  "landingMinImpactSpeed": 3.0,   // world units/s; below = silent touchdown
  "landingEnergy": [9.0, 250.0],  // mass x impactSpeed^2 normalization window
  "landingCount": [4, 18],
  "landingScale": [1.1, 2.4],
  "landingSpreadSpeed": [40, 140], // screen px/s at the reference framing
  "landingOpacity": [0.22, 0.35],
  "landingLife": [0.25, 0.5],
  "footstepSpeedMin": 1.5,        // world units/s; below = no locomotion dust
  "footstepCount": [1, 3],
  "footstepScale": [0.7, 1.2],
  "footstepOpacity": [0.14, 0.26],
  "footstepLife": [0.2, 0.35],
  "strideFactor": 1.6,            // stride = bodyWidth x this
  "refBodyHalfX": 0.4,            // body half extents where width/size factors = 1
  "refBodyHalfY": 0.6,
  "massFactorRange": [0.7, 1.3],  // footstep count x clamp(mass / 1.5, lo, hi)
  "opacityCap": 0.35,
  "lifetimeCap": 0.6,
  "maxBurstCount": 24,
  "maxEventsPerFrame": 8,
  "weatherBlendMax": 0.7          // max color blend toward the active weather
}
