# .NET
bin/
obj/
*.user
.vs/

# Godot
godot/.godot/
# Godot regenerates these on project open (scenes here reference scripts by
# res:// path, not uid://, so the regenerated IDs are never load-bearing)
*.uid
*.import

# Export/build artifacts (regenerate with tools/export-macos.sh)
dist/

# Evolution run output (checkpoints, results, replays) + archived runs
runs/
archive/

# Development-process docs and agent instructions (local-only, not part of the game)
CLAUDE.md
docs/
.claude/

# Paper drafts and other local documents
*.pdf

# IDE
.idea/
.vscode/

# macOS
.DS_Store
